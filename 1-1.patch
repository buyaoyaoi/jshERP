-+                if (StringUtil.isExist(rowObj.get("anotherDepotId"))) {
-+                    addStockLockKey(lockKeys, materialId, rowObj.getLong("anotherDepotId"));
-+                }
-+            }
-+        }
-+        return lockKeys;
-+    }
